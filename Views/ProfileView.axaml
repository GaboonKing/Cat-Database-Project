<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:CatDataViewer.Models"
        mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="150"
        x:Class="CatDataViewer.Views.ProfileView"
        Title="CatProfile">
        <Grid ColumnDefinitions="4*,6*">
            <StackPanel Grid.Column="0" Background="Purple" Spacing="20">
                <TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,10,0,0"/>
                <Border 
                    BorderThickness="5"
                    BorderBrush="Black"
                    ClipToBounds="True"
                    Height="400"
                    Width="400"
                    
                >
                    <Image Source="{Binding ImagePath}" Stretch= "UniformToFill"/>
                </Border>
                <TextBlock Text="{Binding Gender, StringFormat=Sex: }" HorizontalAlignment="Center" FontSize="18"/>   
            </StackPanel>
            <StackPanel Grid.Column="1" Background="DarkBlue" Spacing="10">
                <TextBlock Text="{Binding Bio}" TextAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding Location, StringFormat= 'Found near {0}'}" TextAlignment="Center"/>
                <TextBlock Text="{Binding Temperament, StringFormat='Temperament = '}" TextAlignment="Center"/>
                <Button IsVisible="{Binding CanShowInterest}" Content="I'm interested in adopting this cat" Command="{Binding ExpressInterestCmd}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
</Window>