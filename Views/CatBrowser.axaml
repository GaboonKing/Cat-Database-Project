<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:CatDataViewer.Models"
        x:Class="CatDataViewer.CatBrowserWindow"
        >
    


    <!-- Cat Profiles -->
    <ItemsControl ItemsSource="{Binding Cats}" HorizontalAlignment="Center">
        
        
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Cat">
                <Border 
                    MinWidth="200"
                    BorderThickness="2"
                    Margin="10" 
                    Padding="10" 
                    CornerRadius="8,8,8,8"
                    BorderBrush="Black" 
                    Background="Gray" >
                    <StackPanel>
                        <Border 
                            BorderThickness="3"
                            Margin="10" 
                            CornerRadius="8,8,8,8"
                            BorderBrush="Black" 
                            Background="Gray"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            ClipToBounds="True">
                            <Image Name="CatImage" Source="{Binding RawImagePath}" 
                                Height= "150" 
                                Width= "150" 
                                Stretch= "UniformToFill"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="20" />
                        <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" TextAlignment="Center" FontSize="10"/>
                        <Button x:Name="BioButton" Content="BIO" Background="#75C1DA" BorderBrush="BlueViolet" BorderThickness="2" Click="OpenProfile" HorizontalAlignment="Center"
                        >
                        </Button>
                        
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>

    </ItemsControl>


</UserControl>
