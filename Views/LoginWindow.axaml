<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CatDataViewer.Views.LoginWindow"
        Title="Login"
        Width="400"
        Height="400"
        MinWidth="400"
        MinHeight="350"
        WindowStartupLocation="CenterScreen">

    <Border Padding="30">
        
        <StackPanel Spacing="20">

            <!-- Title -->
            <TextBlock Text="Welcome Back to the Catabase!"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Please sign in to continue"
                       HorizontalAlignment="Center"
                       Opacity="0.7"/>

            <!-- Username -->
            <StackPanel Spacing="5">
                <TextBlock Text="Username"/>
                
                <TextBox x:Name="UsernameInput"
                         Text="{Binding Email}"
                         Watermark="Enter your email"
                         Height="36"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel>
                <TextBlock Text="Password"/>

                <TextBox x:Name="PasswordInput"
                         Text="{Binding Pword}"
                         Watermark="Enter password"
                         PasswordChar="*"
                         Height="36"/>
            </StackPanel>

            <StackPanel>
                <!-- Login Button -->
                <Button Content="Login"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,10,0,0"
                        Command="{Binding LoginCmd}"
                        Background="#4A890C"/>
                <!-- Error Display -->
                <TextBlock x:Name="ErrorBlock" Text="{Binding ErrorMsg}" FontSize="11" Foreground="Red" ></TextBlock>
                <TextBlock Text="New here?" FontWeight="Bold" TextAlignment="Center" FontSize="18"/>
                <Button x:Name="SignUpBtn" Content="Sign up for an Adopter Profile!" Click="OpenSignUpWindow" HorizontalAlignment="Center" Margin="15" Background="GreenYellow"></Button>
                
            </StackPanel>
            

        </StackPanel>

    </Border>
</Window>